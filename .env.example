# Скопируйте в .env.local и заполните. Файлы .env* (кроме этого шаблона) в git не попадают.

# --- Фронтенд (попадает в браузер — здесь только публичные значения) ---
# Project URL и Publishable key (или legacy anon key): Supabase Dashboard → Project Settings → API Keys.
# Для локального стека: npx supabase status
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Только для scripts/seed.ts и scripts/api-security-check.ts (запускаются локально, в браузер не попадают) ---
# Secret key (или legacy service_role key). НИКОГДА не добавляйте префикс VITE_ и не коммитьте.
SUPABASE_SECRET_KEY=
# Пароль для демо-пользователей. Если не задан, скрипт сгенерирует случайный и выведет его.
SEED_PASSWORD=
