# Скопируйте в .env.local и заполните. Файлы .env* (кроме этого шаблона) в git не попадают.

# --- Фронтенд (попадает в браузер — здесь только публичные значения) ---
# Project URL и Publishable key (или legacy anon key): Supabase Dashboard → Project Settings → API Keys.
# Для локального стека: npx supabase status
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- Только для локальных скриптов (в браузер не попадают) ---
# Secret key (или legacy service_role key) — нужен только scripts/seed.ts.
# НИКОГДА не добавляйте префикс VITE_ и не коммитьте.
SUPABASE_SECRET_KEY=
# Пароль демо-сотрудников. seed.ts задаёт его (если пусто — сгенерирует случайный и выведет),
# api-security-check.ts входит с ним от имени сотрудников.
SEED_PASSWORD=
